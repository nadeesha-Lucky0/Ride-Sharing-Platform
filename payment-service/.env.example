# ==============================================================================
# RideLink Fare & Payment Service - Environment Configuration
# ==============================================================================

# Server Port
SERVER_PORT=8084

# MongoDB Database Connection URI
# Local MongoDB:
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/payment_db

# Docker MongoDB:
# SPRING_DATA_MONGODB_URI=mongodb://admin:password@mongodb:27017/payment_db?authSource=admin

# MongoDB Atlas Cloud:
# SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/payment_db?retryWrites=true&w=majority

# Base Fare Calculation Rules Defaults
APP_FARE_BASE_FARE=50.0
APP_FARE_PER_KM_RATE=15.0
APP_FARE_PER_MINUTE_RATE=2.0
APP_FARE_SURGE_MULTIPLIER=1.0
