# ==============================================================================
# RideLink - Ride Management Service Environment Variables (.env.example)
# ==============================================================================

# Server Port
SERVER_PORT=8083

# MongoDB Connection String (Isolated Database for Ride Service)
# Local instance:
# SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/ride_db
#
# Docker Compose network:
# SPRING_DATA_MONGODB_URI=mongodb://admin:password@mongodb:27017/ride_db?authSource=admin
#
# Cloud MongoDB Atlas Cluster:
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@ridemanagementservice.pcw5epw.mongodb.net/ride_db?retryWrites=true&w=majority

# Inter-Service Microservice Endpoints
SERVICES_ACCOUNT_URL=http://localhost:8081
SERVICES_DRIVER_URL=http://localhost:8082
SERVICES_PAYMENT_URL=http://localhost:8084
