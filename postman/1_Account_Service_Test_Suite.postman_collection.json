{
  "info": {
    "_postman_id": "account-service-suite-001",
    "name": "1. Account Service - Full Test Suite",
    "description": "Complete test suite covering 100% of Account Service endpoints (Registration, Login, Token issuance, RBAC profile retrieval, updates, status management, and negative tests).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Register Passenger Account",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var rand = Date.now();",
              "pm.environment.set('passenger_email', 'passenger.' + rand + '@ridelink.com');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
              "var data = pm.response.json();",
              "if (data.userId) { pm.environment.set('passenger_id', data.userId); }",
              "if (data.token) { pm.environment.set('passenger_token', data.token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{passenger_email}}\",\n  \"password\": \"Password@123\",\n  \"firstName\": \"Nimal\",\n  \"lastName\": \"Silva\",\n  \"phoneNumber\": \"+94771112233\",\n  \"role\": \"PASSENGER\"\n}"
        },
        "url": { "raw": "{{account_url}}/api/auth/register", "host": ["{{account_url}}"], "path": ["api", "auth", "register"] }
      }
    },
    {
      "name": "2. Register Driver Account",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "var rand = Date.now();",
              "pm.environment.set('driver_email', 'driver.' + rand + '@ridelink.com');"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
              "var data = pm.response.json();",
              "if (data.userId) { pm.environment.set('driver_user_id', data.userId); }",
              "if (data.token) { pm.environment.set('driver_token', data.token); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{driver_email}}\",\n  \"password\": \"Password@123\",\n  \"firstName\": \"Kamal\",\n  \"lastName\": \"Fernando\",\n  \"phoneNumber\": \"+94774445566\",\n  \"role\": \"DRIVER\"\n}"
        },
        "url": { "raw": "{{account_url}}/api/auth/register", "host": ["{{account_url}}"], "path": ["api", "auth", "register"] }
      }
    },
    {
      "name": "3. Login Passenger",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
              "var data = pm.response.json();",
              "if (data.token) { pm.environment.set('passenger_token', data.token); }",
              "if (data.userId) { pm.environment.set('passenger_id', data.userId); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{passenger_email}}\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": { "raw": "{{account_url}}/api/auth/login", "host": ["{{account_url}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "4. Login Driver",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });",
              "var data = pm.response.json();",
              "if (data.token) { pm.environment.set('driver_token', data.token); }",
              "if (data.userId) { pm.environment.set('driver_user_id', data.userId); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{driver_email}}\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": { "raw": "{{account_url}}/api/auth/login", "host": ["{{account_url}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "5. Get Current User Profile (/me)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{passenger_token}}" }
        ],
        "url": { "raw": "{{account_url}}/api/users/me", "host": ["{{account_url}}"], "path": ["api", "users", "me"] }
      }
    },
    {
      "name": "6. Get User Profile by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{passenger_token}}" }
        ],
        "url": { "raw": "{{account_url}}/api/users/{{passenger_id}}", "host": ["{{account_url}}"], "path": ["api", "users", "{{passenger_id}}"] }
      }
    },
    {
      "name": "7. Get User Profile by Email",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{passenger_token}}" }
        ],
        "url": {
          "raw": "{{account_url}}/api/users/email?email={{passenger_email}}",
          "host": ["{{account_url}}"],
          "path": ["api", "users", "email"],
          "query": [{ "key": "email", "value": "{{passenger_email}}" }]
        }
      }
    },
    {
      "name": "8. Update User Profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () { pm.response.to.have.status(200); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{passenger_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Nimal Updated\",\n  \"lastName\": \"Silva Updated\",\n  \"phoneNumber\": \"+94779998877\"\n}"
        },
        "url": { "raw": "{{account_url}}/api/users/{{passenger_id}}", "host": ["{{account_url}}"], "path": ["api", "users", "{{passenger_id}}"] }
      }
    },
    {
      "name": "9. Update Account Status (Status Management)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Account Status updated successfully', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 403]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{passenger_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": { "raw": "{{account_url}}/api/users/{{passenger_id}}/status", "host": ["{{account_url}}"], "path": ["api", "users", "{{passenger_id}}", "status"] }
      }
    },
    {
      "name": "10. Negative Test - Duplicate Email Registration (Expected 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Duplicate email rejected with 400 Bad Request', function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{passenger_email}}\",\n  \"password\": \"Password@123\",\n  \"firstName\": \"Duplicate\",\n  \"lastName\": \"Test\",\n  \"phoneNumber\": \"+94771112233\",\n  \"role\": \"PASSENGER\"\n}"
        },
        "url": { "raw": "{{account_url}}/api/auth/register", "host": ["{{account_url}}"], "path": ["api", "auth", "register"] }
      }
    },
    {
      "name": "11. Negative Test - Invalid Login Password (Expected 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Invalid credentials rejected with 400', function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{passenger_email}}\",\n  \"password\": \"WrongPassword123\"\n}"
        },
        "url": { "raw": "{{account_url}}/api/auth/login", "host": ["{{account_url}}"], "path": ["api", "auth", "login"] }
      }
    }
  ]
}
