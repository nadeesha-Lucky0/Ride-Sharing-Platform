# ==============================================================================
# RideLink - Driver & Vehicle Service Environment Variables (.env.example)
# ==============================================================================

# HTTP Server Port
SERVER_PORT=8082

# MongoDB Connection String (Isolated Database for Driver Service)
# Option 1: Local MongoDB instance
# SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/driver_db
#
# Option 2: Docker Compose Network
# SPRING_DATA_MONGODB_URI=mongodb://admin:password@mongodb:27017/driver_db?authSource=admin
#
# Option 3: MongoDB Atlas Cloud Cluster
SPRING_DATA_MONGODB_URI=mongodb+srv://<username>:<password>@driverandvehicleservice.ge93avy.mongodb.net/driver_db?retryWrites=true&w=majority
